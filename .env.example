# Gemini API Key - required for Google Gemini integration
# Get your API key (free tier available) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional - defaults to gemini-3.5-flash-lite if unset)
# gemini-3.5-flash-lite has the most generous free-tier rate limits.
GEMINI_MODEL=gemini-3.5-flash-lite
